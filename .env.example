# BullRix AI 2.0 Environment Configuration
# Copy this file to .env or .env.local and fill in your values.
# NEVER commit real API keys or secrets to version control.

# ---------------------------------------------------------------------------
# Server / Port Configuration
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
VITE_API_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Google Gemini API (Generative AI Engine & Research Assistant)
# Get your API key: https://aistudio.google.com/
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Google OAuth 2.0 (Google Identity Services)
# Configure at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:5173, https://bullrix-ai.vercel.app
# Authorized Redirect URIs: http://localhost:5173/auth/callback
# ---------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ---------------------------------------------------------------------------
# DigiLocker Requester Integration (Phase 5 - Requires Org Approval)
# Official portal: https://partners.digitallocker.gov.in/
# ---------------------------------------------------------------------------
DIGILOCKER_CLIENT_ID=your_digilocker_client_id_here
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret_here
DIGILOCKER_REDIRECT_URI=http://localhost:5173/auth/digilocker/callback
DIGILOCKER_ENV=sandbox

# ---------------------------------------------------------------------------
# Market Data & News Providers (Optional overrides / Free tier defaults)
# ---------------------------------------------------------------------------
MARKET_DATA_PROVIDER=hybrid
CACHE_TTL_SECONDS=300
NEWS_LOOKBACK_DAYS=14
